TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# The OAuth client that users sign in to Google through.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base64 of 32 random bytes, for example from: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Where the service is reached, with no trailing slash.
PUBLIC_BASE_URL=

# Who runs the service and how to reach them. Both are shown on the public pages.
OPERATOR_NAME=
OPERATOR_CONTACT=

# The bot's assistant, which answers questions that are asked in plain language. It asks an AI provider for each
# answer, through a chat completions API of the kind that OpenAI has. The key is that provider's. With no key the
# bot has no assistant, and with one it has it for every user.
AI_API_KEY=
# Optional. A key of a second account at the same provider. When the first key's account answers that it has had
# as many requests or tokens as it takes, the request is sent again once with this one.
AI_FALLBACK_API_KEY=
# Optional. Where the provider's API is reached, with no trailing slash, and the model to ask there. Left empty,
# they are https://api.groq.com/openai/v1 and openai/gpt-oss-120b.
AI_BASE_URL=
AI_MODEL=
# Optional. The model that reads the purchases out of a photo, which has to be one that takes images. It is asked
# at the same address, with the same key. Left empty, it is qwen/qwen3.8-27b when AI_BASE_URL is left empty too.
# With an AI_BASE_URL of your own and no model named here, the bot reads no photos.
AI_VISION_MODEL=
