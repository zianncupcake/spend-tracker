// Template for the real config. Copy it to wrangler.jsonc (git-ignored) and add
// your own D1 "database_id" there. The tests read this file as it is, and a
// deploy makes its config from it, so what is merged here is deployed. That is
// the work of scripts/deploy-config.mjs, which reads JSON with // comments: it
// takes no other kind of comment, and no trailing comma.
{
  "name": "spend-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Every minute, one connected mailbox is checked for new bank alerts.
  "triggers": {
    "crons": ["* * * * *"]
  },
  // Workers Logs: Cloudflare keeps what the Worker writes to its console, which
  // is the service's log. Without this it keeps none of it.
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spend-tracker",
      "migrations_dir": "migrations"
    }
  ]
}
